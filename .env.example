# Copy to .env.local and fill in. Never put real values in this file — it is
# the one env file that is meant to be committed, so anything written here is
# public the moment the repository is.
#
# Supabase — project must be created in ap-southeast-1 (Singapore)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key. Public by design — it is bound by RLS, which is enabled on
# every table. Prefer this over the legacy anon JWT: it rotates independently.
# Supabase dashboard → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER prefix with NEXT_PUBLIC_ — this key bypasses RLS, and a
# leak is a total database compromise.
#
# Nothing in the application needs it today: the admin panel runs on the
# signed-in admin's own session (ADR 0006) and customers run on theirs. It is
# needed only by the payment webhook, which has no session. Leave it blank
# until that exists.
SUPABASE_SERVICE_ROLE_KEY=

# Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The number every "chat to us" link opens. Digits only, starting 60.
# The live value is edited in the admin panel (Settings), not here.
NEXT_PUBLIC_WHATSAPP_NUMBER=60123456789

# Payment gateway — pick one covering FPX + DuitNow + e-wallets + cards
# (Fiuu, Xendit, HitPay or Chip). Not needed until checkout takes real money;
# /pay is a stand-in today (ADR 0007).
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
